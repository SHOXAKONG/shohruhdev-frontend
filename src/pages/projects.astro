---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ContactCta from "../components/ContactCta.astro";
import { projects, site, stats } from "../data/site";

const indexStats = [
  { value: String(projects.length).padStart(2, "0"), label: "problems solved" },
  { value: stats[1].value, label: "workflows automated" },
  { value: stats[0].value, label: "years shipping" },
];
---

<BaseLayout
  title={`Work — ${site.name}`}
  description="Four problems Shohruh Bekmurodov was handed, what was actually wrong with each, and what changed."
>
  <header class="reveal in wrap grid grid-cols-[minmax(0,1.5fr)_minmax(0,0.75fr)] items-end gap-14 pt-[68px] pb-[52px] max-[900px]:grid-cols-[minmax(0,1fr)] max-[900px]:gap-[34px] max-[900px]:pt-11 max-[900px]:pb-9">
    <div>
      <span class="font-mono text-xs font-medium tracking-[0.16em] text-accent uppercase">
        Selected work
      </span>
      <h1 class="my-4 font-serif text-[clamp(36px,4.6vw,58px)] leading-[1.04] font-semibold tracking-[-0.015em]">
        What was broken,<br /> and what I changed.
      </h1>
      <p class="max-w-[52ch] text-[17.5px] text-body">
        {projects.length} problems I was handed and the systems that came out of them.
        Each one is written the way it happened: what people were working around, what I
        changed about it, and what that bought them.
      </p>
    </div>
    <aside class="rounded-md border border-line bg-surface px-[26px] py-6">
      <span class="font-mono text-[10px] tracking-[0.2em] text-muted">INDEX</span>
      <dl class="my-4 mb-5">
        {
          indexStats.map((stat) => (
            <div class="flex items-baseline gap-3 border-b border-dashed border-line py-[9px] last:border-b-0">
              <dt class="min-w-[44px] font-serif text-2xl font-semibold text-ink [font-variant-numeric:tabular-nums]">
                {stat.value}
              </dt>
              <dd class="text-[13.5px] text-body">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
      <a
        class="group inline-flex items-center gap-[7px] text-[13.5px] font-semibold text-accent"
        href={site.github}
      >
        Everything else on GitHub{" "}
        <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
      </a>
    </aside>
  </header>

  <section class="wrap pb-[72px]">
    {projects.map((project, i) => <ProjectRow project={project} index={i} />)}
  </section>

  <ContactCta />
</BaseLayout>
