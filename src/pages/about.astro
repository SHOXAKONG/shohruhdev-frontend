---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCta from "../components/ContactCta.astro";
import { principles, process, site, skills } from "../data/site";

const facts = [
  { label: "Role", value: site.role },
  { label: "At", value: site.company },
  { label: "Good at", value: "Finding the real problem" },
];
---

<BaseLayout
  title={`About — ${site.name}`}
  description="Shohruh Bekmurodov — software engineer. The problems he works on, and how he goes about solving them."
>
  <header class="reveal in wrap pt-24 pb-14">
    <span class="font-mono text-xs font-medium tracking-[0.16em] text-accent uppercase">
      About
    </span>
    <h1 class="my-4 mb-9 max-w-[16ch] font-serif text-[clamp(38px,5vw,62px)] leading-[1.04] font-semibold tracking-[-0.015em]">
      I build the layer<br /> nobody sees{" "}
      <em class="font-light text-accent italic">until it breaks.</em>
    </h1>
    <dl class="grid grid-cols-4 gap-5 border-t border-line pt-[22px] max-[900px]:grid-cols-2">
      {
        facts.map((fact) => (
          <div>
            <dt class="mb-1.5 font-mono text-[10px] tracking-[0.18em] text-muted uppercase">
              {fact.label}
            </dt>
            <dd class="text-[15px] font-medium">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </header>

  <div class="wrap grid grid-cols-[300px_minmax(0,1fr)] items-start gap-[60px] pt-5 pb-10 max-[900px]:grid-cols-[minmax(0,1fr)] max-[900px]:gap-9">
    <aside class="reveal sticky top-[100px] max-[900px]:static">
      <div class="rounded-lg border border-line bg-surface p-[26px]">
        <div class="mb-[18px] flex items-center gap-3.5">
          <div
            class="grid size-[54px] place-items-center rounded-sm bg-ink font-mono text-[17px] font-medium tracking-[0.02em] text-paper"
            aria-hidden="true"
          >
            {site.initials}
          </div>
          <div>
            <b class="block font-serif text-[17px] font-semibold">{site.name}</b>
            <span class="text-[13.5px] text-body">{site.role}</span>
          </div>
        </div>
        <p class="border-b border-line pb-[18px] text-[14.5px] leading-[1.6] text-body">
          {site.bio}
        </p>
        <span class="my-[18px] inline-flex items-center gap-[9px] rounded-sm bg-accent-tint px-3.5 py-[7px] text-[13px] font-semibold text-accent">
          <span class="size-2 rounded-full bg-accent shadow-[0_0_0_4px_rgba(47,191,155,0.16)]" />
          Available for new projects
        </span>
        <div class="flex flex-wrap gap-2.5">
          <a
            class="inline-flex items-center gap-2 rounded-sm bg-accent px-[18px] py-[11px] text-sm font-semibold tracking-[-0.01em] text-paper transition-colors duration-[180ms] ease-out hover:bg-accent-strong"
            href={`mailto:${site.email}`}
          >
            Email me
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-sm border-[1.5px] border-line bg-surface px-[18px] py-[11px] text-sm font-semibold tracking-[-0.01em] text-ink transition-colors duration-[180ms] ease-out hover:border-accent hover:text-accent"
            href={site.github}
          >
            GitHub
          </a>
        </div>
      </div>
    </aside>

    <main>
      <section class="reveal">
        <h2 class="mb-[26px] font-serif text-3xl font-semibold tracking-[-0.01em]">
          What I work on
        </h2>
        <div class="relative pl-[26px] before:absolute before:top-2 before:bottom-2 before:left-1 before:w-0.5 before:rounded-sm before:bg-accent before:opacity-35 before:content-['']">
          {
            skills.map((skill) => (
              <div class="relative pb-[30px] last:pb-0">
                <span class="absolute top-[7px] left-[-26px] size-2.5 rounded-full border-2 border-accent bg-surface" />
                <div>
                  <h3 class="mb-1 text-[17px] font-semibold">{skill.title}</h3>
                  <p class="mb-3 text-[15px] text-body">{skill.sub}</p>
                  <div class="flex flex-wrap gap-2">
                    {skill.items.map((item) => (
                      <span class="rounded-[8px] bg-paper-2 px-2.5 py-[5px] text-[12.5px] text-body">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="reveal mt-14">
        <h2 class="mb-[26px] font-serif text-3xl font-semibold tracking-[-0.01em]">
          How I work
        </h2>
        <div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
          {
            principles.map((principle, i) => (
              <article class="rounded-md border border-line bg-surface p-6 pt-6 pb-[26px]">
                <span class="rounded-[8px] bg-accent-tint px-2.5 py-[3px] font-serif text-[13px] font-semibold text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-3.5 mb-2 font-serif text-[19px] font-semibold">
                  {principle.title}
                </h3>
                <p class="text-[14.5px] leading-[1.6] text-body">{principle.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="process" class="reveal mt-14">
        <h2 class="mb-[26px] font-serif text-3xl font-semibold tracking-[-0.01em]">
          How a problem goes
        </h2>
        <div class="border-t border-line">
          {
            process.map((phase, i) => (
              <div
                class:list={[
                  `tone-${phase.tone}`,
                  "grid grid-cols-[190px_minmax(0,1fr)] items-baseline gap-6 border-b border-line px-1 py-5 max-[560px]:grid-cols-[minmax(0,1fr)] max-[560px]:gap-2.5",
                ]}
              >
                <span class="flex items-baseline gap-2.5 font-mono text-[11px] tracking-[0.14em] text-[color:var(--tone-fg)] uppercase">
                  <span class="rounded-[6px] bg-[color:var(--tone-bg)] px-[7px] py-[3px] tracking-[0.06em]">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  {phase.step}
                </span>
                <p class="text-[15px] leading-[1.6] text-body">{phase.body}</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </div>

  <ContactCta />
</BaseLayout>
