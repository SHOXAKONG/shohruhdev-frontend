---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillCard from "../components/SkillCard.astro";
import MiniPost from "../components/MiniPost.astro";
import ContactCta from "../components/ContactCta.astro";
import { projects, skills } from "../data/site";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero />

  <section id="work" class="wrap py-[72px]">
    <SectionHead
      eyebrow="Selected work"
      title="Things I've built"
      linkLabel="View all projects"
      linkHref="/projects"
    />
    <div class="grid grid-cols-2 gap-6 max-[720px]:grid-cols-1">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <section class="border-y border-line bg-paper-2">
    <div class="wrap py-[72px]">
      <SectionHead eyebrow="What I do" title="Three things, done well" />
      <div class="mt-11 grid grid-cols-3 gap-[22px] max-[820px]:grid-cols-1">
        {skills.map((skill) => <SkillCard skill={skill} />)}
      </div>
    </div>
  </section>

  <section class="wrap py-[72px]">
    <SectionHead
      eyebrow="Writing"
      title="From the blog"
      linkLabel="All posts"
      linkHref="/blog"
    />
    <div class="grid grid-cols-3 gap-[22px] max-[820px]:grid-cols-1">
      {posts.map((post) => <MiniPost post={post} />)}
    </div>
  </section>

  <ContactCta />
</BaseLayout>
