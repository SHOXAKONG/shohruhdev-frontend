---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillCard from "../components/SkillCard.astro";
import MiniPost from "../components/MiniPost.astro";
import ContactCta from "../components/ContactCta.astro";
import { projects, skills } from "../data/site";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero />

  <section id="work" class="wrap section">
    <SectionHead
      eyebrow="Selected work"
      title="Things I've built"
      linkLabel="View all projects"
      linkHref="/projects"
    />
    <div class="work-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <section class="band">
    <div class="wrap section">
      <SectionHead eyebrow="What I do" title="Three things, done well" />
      <div class="skill-grid">
        {skills.map((skill) => <SkillCard skill={skill} />)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <SectionHead
      eyebrow="Writing"
      title="From the blog"
      linkLabel="All posts"
      linkHref="/blog"
    />
    <div class="mini-grid">
      {posts.map((post) => <MiniPost post={post} />)}
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 720px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 44px;
  }

  @media (max-width: 820px) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  @media (max-width: 820px) {
    .mini-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
