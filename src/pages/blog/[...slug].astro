---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, site } from "../../data/site";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { title, description, dek, tag, tone, pubDate, readingTime, heroCaption } =
  post.data;

const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={`${title} — ${site.name}`} description={description}>
  <article>
    <section class="reveal in wrap mx-auto max-w-[760px] pt-14 pb-2 text-center">
      <div class="mb-5 flex flex-wrap items-center justify-center gap-3 text-[13px] text-muted">
        <span class="rounded-sm border border-line px-2 py-1 font-mono text-[10.5px] font-medium tracking-[0.1em] text-muted uppercase">
          {tag}
        </span>{" "}
        · {formatDate(pubDate)} · {readingTime} min read
      </div>
      <h1 class="font-serif text-[clamp(32px,4.4vw,50px)] leading-[1.08] font-semibold tracking-[-0.01em]">
        {title}
      </h1>
      <p class="mt-5 text-[19px] leading-[1.5] text-body">{dek ?? description}</p>
    </section>

    {
      heroCaption && (
        <div class="wrap">
          <p class="mt-[34px] border-t border-b border-line py-3.5 font-mono text-[11.5px] tracking-[0.12em] text-muted uppercase">
            {heroCaption}
          </p>
        </div>
      )
    }

    <div
      class:list={[
        "wrap mx-auto grid gap-14 pt-12 pb-10",
        toc.length > 1
          ? "max-w-[1000px] grid-cols-[220px_minmax(0,1fr)] max-[820px]:grid-cols-[minmax(0,1fr)] max-[820px]:gap-0"
          : "max-w-[760px] grid-cols-[minmax(0,1fr)]",
      ]}
    >
      {
        toc.length > 1 && (
          <nav class="sticky top-[100px] self-start max-[820px]:hidden" aria-label="On this page">
            <h4 class="mb-4 font-mono text-[11px] tracking-[0.16em] text-muted uppercase">
              On this page
            </h4>
            {toc.map((heading) => (
              <a
                data-toc-link
                class="block border-l-2 border-line py-1.5 pl-3.5 text-sm text-body transition-colors duration-200 hover:border-accent hover:text-accent"
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        )
      }
      <div class:list={["prose max-w-[680px]", { "mx-auto": toc.length <= 1 }]}>
        <Content />

        <div class="mt-11 flex items-center gap-4 rounded-md border border-line bg-surface p-6">
          <div
            class="grid size-[54px] flex-none place-items-center rounded-sm bg-ink font-mono text-[17px] font-medium tracking-[0.02em] text-paper"
            aria-hidden="true"
          >
            {site.initials}
          </div>
          <div>
            <b class="block font-serif text-[17px] font-semibold">{site.name}</b>
            <span class="text-sm text-body">{site.authorBio}</span>
          </div>
        </div>
      </div>
    </div>
  </article>
  <div style="height:64px"></div>
</BaseLayout>

<script>
  // Highlight the table-of-contents entry for the section being read.
  const TOC_OFF = ["border-line", "text-body"];
  const TOC_ON = ["border-accent", "text-accent"];

  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const headings = Array.from(document.querySelectorAll<HTMLElement>(".prose h2"));
    if (!links.length || !headings.length) return;

    const onScroll = () => {
      let current = "";
      for (const heading of headings) {
        if (window.scrollY >= heading.offsetTop - 140) current = heading.id;
      }
      for (const link of links) {
        const active = link.hash === `#${current}`;
        link.classList.remove(...TOC_OFF, ...TOC_ON);
        link.classList.add(...(active ? TOC_ON : TOC_OFF));
      }
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  initToc();
  document.addEventListener("astro:page-load", initToc);
</script>

<style>
  /* ---- rendered markdown ----------------------------------------
     Markdown-rendered HTML has no template element to attach Tailwind
     classes to, so this styling has to stay hand-written CSS. */
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    margin: 38px 0 14px;
    letter-spacing: -0.01em;
    scroll-margin-top: 110px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 22px;
    margin: 30px 0 12px;
    scroll-margin-top: 110px;
  }

  .prose :global(p) {
    color: var(--body);
    font-size: 17px;
    line-height: 1.72;
    margin-bottom: 20px;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a:not(.btn)) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
    padding-left: 20px;
    color: var(--body);
    font-size: 17px;
    line-height: 1.7;
    list-style: revert;
  }

  .prose :global(li) {
    margin-bottom: 8px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    background: var(--accent-tint);
    padding: 18px 22px;
    border-radius: 0 12px 12px 0;
    margin: 24px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    color: var(--ink);
  }

  .prose :global(blockquote p) {
    color: inherit;
    font-size: inherit;
    margin: 0;
  }

  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2px 6px;
    color: var(--ink);
  }

  /* Shiki sets background-color inline, so this needs !important to land. */
  .prose :global(pre) {
    background: #2a2521 !important;
    border-radius: 14px;
    padding: 20px 22px;
    margin: 24px 0;
    overflow: auto;
    font-size: 13.5px;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    font-family: var(--font-mono);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 36px 0;
  }
</style>
