---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, site } from "../../data/site";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { title, description, dek, tag, tone, pubDate, readingTime, heroCaption } =
  post.data;

const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={`${title} — ${site.name}`} description={description}>
  <article>
    <section class="wrap art-head reveal in">
      <div class="meta">
        <span class:list={["tagchip", `tone-${tone}`]}>{tag}</span> · {
          formatDate(pubDate)
        } · {readingTime} min read
      </div>
      <h1 class="serif">{title}</h1>
      <p class="dek">{dek ?? description}</p>
    </section>

    {
      heroCaption && (
        <div class="wrap">
          <p class="art-cap">{heroCaption}</p>
        </div>
      )
    }

    <div class:list={["wrap", "art-layout", { "no-toc": toc.length <= 1 }]}>
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="On this page">
            <h4>On this page</h4>
            {toc.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        )
      }
      <div class:list={["prose", { "prose-wide": toc.length <= 1 }]}>
        <Content />

        <div class="author">
          <div class="avatar" aria-hidden="true">{site.initials}</div>
          <div class="abody">
            <b>{site.name}</b>
            <span>{site.authorBio}</span>
          </div>
        </div>
      </div>
    </div>
  </article>
  <div style="height:64px"></div>
</BaseLayout>

<script>
  // Highlight the table-of-contents entry for the section being read.
  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc a"));
    const headings = Array.from(document.querySelectorAll<HTMLElement>(".prose h2"));
    if (!links.length || !headings.length) return;

    const onScroll = () => {
      let current = "";
      for (const heading of headings) {
        if (window.scrollY >= heading.offsetTop - 140) current = heading.id;
      }
      for (const link of links) {
        link.classList.toggle("active", link.hash === `#${current}`);
      }
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  initToc();
  document.addEventListener("astro:page-load", initToc);
</script>

<style>
  .art-head {
    padding-block: 56px 8px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .art-head .meta {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .art-head h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(32px, 4.4vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .art-head .dek {
    color: var(--body);
    font-size: 19px;
    margin-top: 20px;
    line-height: 1.5;
  }

  .art-cap {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
    margin-top: 34px;
  }

  .art-layout {
    display: grid;
    /* minmax(0, …) so a wide code block scrolls inside the column instead of
       stretching the track past the viewport. */
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 56px;
    padding-block: 48px 40px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .art-layout.no-toc {
    grid-template-columns: minmax(0, 1fr);
    max-width: 760px;
  }

  .toc {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .toc h4 {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .toc a {
    display: block;
    font-size: 14px;
    color: var(--body);
    padding: 7px 0 7px 14px;
    border-left: 2px solid var(--line);
    transition: 0.2s;
  }

  .toc a:hover,
  .toc a.active {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---- rendered markdown ---------------------------------------- */
  .prose {
    max-width: 680px;
  }

  .prose.prose-wide {
    margin: 0 auto;
  }

  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    margin: 38px 0 14px;
    letter-spacing: -0.01em;
    scroll-margin-top: 110px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 22px;
    margin: 30px 0 12px;
    scroll-margin-top: 110px;
  }

  .prose :global(p) {
    color: var(--body);
    font-size: 17px;
    line-height: 1.72;
    margin-bottom: 20px;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a:not(.btn)) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
    padding-left: 20px;
    color: var(--body);
    font-size: 17px;
    line-height: 1.7;
    list-style: revert;
  }

  .prose :global(li) {
    margin-bottom: 8px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    background: var(--accent-tint);
    padding: 18px 22px;
    border-radius: 0 12px 12px 0;
    margin: 24px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    color: var(--ink);
  }

  .prose :global(blockquote p) {
    color: inherit;
    font-size: inherit;
    margin: 0;
  }

  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2px 6px;
    color: var(--ink);
  }

  /* Shiki sets background-color inline, so this needs !important to land. */
  .prose :global(pre) {
    background: #2a2521 !important;
    border-radius: 14px;
    padding: 20px 22px;
    margin: 24px 0;
    overflow: auto;
    font-size: 13.5px;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    font-family: var(--font-mono);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 36px 0;
  }

  /* ---- author card ---------------------------------------------- */
  .author {
    display: flex;
    gap: 16px;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 24px;
    margin-top: 44px;
  }

  .author .avatar {
    flex: none;
  }

  .abody b {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 17px;
    display: block;
  }

  .abody span {
    font-size: 14px;
    color: var(--body);
  }

  @media (max-width: 820px) {
    .art-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .toc {
      display: none;
    }
  }
</style>
