---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeaturedPost from "../../components/FeaturedPost.astro";
import PostCard from "../../components/PostCard.astro";
import { blogCategories, site } from "../../data/site";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = posts.find((post) => post.data.featured);
const rest = posts.filter((post) => post !== featured);

const filters = ["All", ...blogCategories];
---

<BaseLayout
  title={`Blog — ${site.name}`}
  description="Notes from the pipeline: ETL patterns, Postgres tuning, backend auth, and the occasional Go side-project."
>
  <section class="reveal in wrap pt-20 pb-12 text-center">
    <span class="font-mono text-xs font-medium tracking-[0.16em] text-accent uppercase">
      Writing &amp; notes
    </span>
    <h1 class="my-3.5 font-serif text-[clamp(40px,5vw,60px)] font-semibold tracking-[-0.01em]">
      Notes from the pipeline
    </h1>
    <p class="mx-auto max-w-[540px] text-lg text-body">
      Things I learn while building data infrastructure — ETL patterns, Postgres tuning,
      backend auth, and the occasional Go side-project.
    </p>
    <div
      class="mt-9 mb-2 flex flex-wrap justify-center gap-2.5"
      role="group"
      aria-label="Filter posts by topic"
    >
      {
        filters.map((filter) => (
          <button
            class:list={[
              "cursor-pointer rounded-sm border px-[18px] py-2.5 font-[inherit] text-[13px] font-semibold transition-colors duration-200",
              filter === "All"
                ? "border-ink bg-ink text-paper"
                : "border-line bg-surface text-body hover:border-ink hover:bg-ink hover:text-paper",
            ]}
            type="button"
            data-filter={filter}
            aria-pressed={filter === "All" ? "true" : "false"}
          >
            {filter}
          </button>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    {featured && <FeaturedPost post={featured} />}

    <div class="mt-6 max-w-[880px] [&_[hidden]]:hidden" id="blog-grid">
      {rest.map((post) => <PostCard post={post} />)}
    </div>
    <p class="py-6 pt-6 pb-2 text-center text-muted" id="blog-empty" hidden>
      No posts in this topic yet.
    </p>
  </section>
  <div style="height:64px"></div>
</BaseLayout>

<script>
  // Topic filter. Cards carry `data-category`; "All" clears the filter.
  const ON = ["border-ink", "bg-ink", "text-paper"];
  const OFF = [
    "border-line",
    "bg-surface",
    "text-body",
    "hover:border-ink",
    "hover:bg-ink",
    "hover:text-paper",
  ];

  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const grid = document.getElementById("blog-grid");
    const empty = document.getElementById("blog-empty");
    if (!buttons.length || !grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-category]"));

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "All";

        for (const other of buttons) {
          const on = other === button;
          other.classList.remove(...ON, ...OFF);
          other.classList.add(...(on ? ON : OFF));
          other.setAttribute("aria-pressed", String(on));
        }

        let shown = 0;
        for (const card of cards) {
          const match = filter === "All" || card.dataset.category === filter;
          card.hidden = !match;
          if (match) shown++;
        }

        if (empty) empty.hidden = shown > 0;
      });
    }
  }

  initFilters();
  document.addEventListener("astro:page-load", initFilters);
</script>
