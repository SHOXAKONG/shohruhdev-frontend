---
import BaseLayout from "../layouts/BaseLayout.astro";
import ErrorState from "../components/ErrorState.astro";
import { site } from "../data/site";
---

<BaseLayout title={`Page not found — ${site.name}`} description="That page doesn't exist.">
  <ErrorState
    eyebrow="Error 404"
    titleLead="This pipeline"
    titleEm="has a broken link."
    lead="The page you asked for isn't here — moved, renamed, or it never existed. The rest of the site is fine."
    pipeLabel="Request received and routed, then not found"
    pipe={[
      { label: "Request", state: "ok" },
      { label: "Route", state: "ok" },
      { label: "404", state: "fail" },
    ]}
  />
</BaseLayout>
