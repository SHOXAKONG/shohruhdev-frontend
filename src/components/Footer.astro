---
import Logo from "./Logo.astro";
import { footerColumns, site } from "../data/site";

const year = new Date().getFullYear();

// Drop placeholder links rather than rendering something that goes nowhere.
const columns = footerColumns.map((col) => ({
  ...col,
  links: col.links.filter((link) => link.href && link.href !== "#"),
}));
---

<footer class="wrap border-t border-line pt-14 pb-10">
  <div class="mb-10 flex flex-wrap justify-between gap-10">
    <div class="max-w-[320px]">
      <Logo />
      <p class="mt-3.5 text-sm text-body">{site.bio}</p>
    </div>
    <div class="flex flex-wrap gap-16">
      {
        columns.map((col) => (
          <div>
            <h4 class="mb-4 font-mono text-[11px] tracking-[0.16em] text-muted uppercase">
              {col.heading}
            </h4>
            {col.links.map((link) => (
              <a
                class="mb-[11px] block text-sm text-body transition-colors duration-200 hover:text-accent"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="flex flex-wrap justify-between gap-3 border-t border-line pt-6 text-[13px] text-muted">
    <span>© {year} {site.name}</span>
  </div>
</footer>
