---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, tag, readingTime } = post.data;
---

<a
  class="reveal flex min-h-[220px] flex-col gap-3.5 rounded-md border border-line bg-surface p-6 transition-colors duration-[250ms] ease-out hover:border-ink"
  href={`/blog/${post.id}`}
>
  <div class="flex items-center gap-2.5 text-xs text-muted">
    <span class="rounded-sm border border-line px-2 py-1 font-mono text-[10.5px] font-medium tracking-[0.1em] text-muted uppercase">
      {tag}
    </span>{" "}
    · {readingTime} min read
  </div>
  <h3 class="font-serif text-xl leading-tight font-semibold">{title}</h3>
  <span class="mt-auto text-[13px] font-semibold text-accent">Read post →</span>
</a>
