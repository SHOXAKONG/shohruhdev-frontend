---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, tag, readingTime } = post.data;
---

<a
  class="reveal group flex flex-col gap-2 border-b border-line py-6 first:pt-0 last:border-b-0"
  href={`/blog/${post.id}`}
>
  <div class="flex items-center gap-3 font-mono text-[11px] tracking-[0.1em] text-muted uppercase">
    <span>{tag}</span>
    <span aria-hidden="true">·</span>
    <span>{readingTime} min read</span>
  </div>
  <h3 class="flex items-baseline justify-between gap-4 font-serif text-xl font-semibold transition-colors duration-200 group-hover:text-accent">
    <span>{title}</span>
    <span class="shrink-0 text-base text-accent opacity-0 transition-opacity duration-200 group-hover:opacity-100">
      →
    </span>
  </h3>
</a>
