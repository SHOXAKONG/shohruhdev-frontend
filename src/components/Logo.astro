---
import { site } from "../data/site";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

{/*
  Mark only — the serif SB monogram carries the identity on its own. The link
  still has an accessible name for screen readers and the tab order.
  inline-flex so the link hugs the mark instead of stretching across its
  container (the footer column is 320px wide).
*/}
<a class="group inline-flex items-center" href={href} aria-label={`${site.name} — home`}>
  <span
    class="grid size-9 place-items-center rounded-sm bg-ink pr-[0.04em] font-mono text-[13px] font-medium tracking-[0.02em] text-paper transition-transform duration-[250ms] ease-out group-hover:bg-accent"
    aria-hidden="true"
  >
    {site.initials}
  </span>
</a>
