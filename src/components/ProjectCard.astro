---
import type { Project } from "../data/site";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article class="reveal flex flex-col border-t-2 border-ink bg-surface p-8 transition-colors duration-[250ms] ease-out hover:border-accent">
  <header class="mb-[18px] flex items-baseline gap-3 border-b border-line pb-3.5">
    <span class="font-mono text-[10.5px] tracking-[0.14em] text-accent uppercase">{number}</span>
    <span class="font-mono text-[10.5px] tracking-[0.14em] text-muted uppercase">{project.category}</span>
  </header>

  <h3 class="text-[23px] leading-[1.15] font-bold tracking-[-0.02em]">{project.title}</h3>
  <p class="my-1.5 mb-5 text-[15px] text-accent">{project.outcome}</p>

  <dl class="grid grid-cols-[74px_minmax(0,1fr)] gap-x-4 gap-y-1.5 border-t border-line pt-[18px] max-[560px]:grid-cols-[minmax(0,1fr)] max-[560px]:gap-1">
    <dt class="pt-[3px] font-mono text-[10px] tracking-[0.12em] text-muted uppercase">Problem</dt>
    <dd class="text-[14.5px] leading-[1.55] text-body max-[560px]:mb-2.5">{project.problem}</dd>
    <dt class="pt-[3px] font-mono text-[10px] tracking-[0.12em] text-muted uppercase">Change</dt>
    <dd class="text-[14.5px] leading-[1.55] text-body max-[560px]:mb-2.5">{project.approach}</dd>
  </dl>

  {
    project.href && (
      <a
        class="mt-5 inline-flex items-center gap-[7px] text-sm font-semibold text-accent"
        href={project.href}
      >
        View project <span>→</span>
      </a>
    )
  }
</article>
