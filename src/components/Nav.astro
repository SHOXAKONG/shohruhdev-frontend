---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { navItems } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

// The "Article" tab jumps straight to the featured post (newest, if none is
// flagged), so there's no hardcoded slug to go stale when posts change.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const highlight = posts.find((post) => post.data.featured) ?? posts[0];

const tabs = [
  ...navItems,
  ...(highlight ? [{ label: "Article", href: `/blog/${highlight.id}` }] : []),
];

// On a post page the "Article" tab owns the active state, not "Blog".
const onPost = path.startsWith("/blog/");
const isActive = (href: string) => {
  if (onPost) return href.startsWith("/blog/");
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="sticky top-0 z-50 border-b border-line bg-nav-bg backdrop-blur-md">
  <div class="wrap flex h-19 items-center justify-between gap-5 max-[860px]:h-auto max-[860px]:flex-wrap max-[860px]:py-3.5">
    <Logo />
    <nav
      data-tabs
      class="flex gap-0.5 max-[860px]:order-3 max-[720px]:max-w-full max-[720px]:justify-start max-[720px]:overflow-x-auto max-[720px]:[scrollbar-width:none] max-[720px]:[overscroll-behavior-x:contain] max-[720px]:[-ms-overflow-style:none] max-[720px]:[&::-webkit-scrollbar]:hidden"
      aria-label="Primary"
    >
      {
        tabs.map((item) => (
          <a
            class:list={[
              "whitespace-nowrap border-b-2 px-3.5 py-2 text-sm font-medium transition-colors duration-[180ms] ease-out",
              isActive(item.href)
                ? "border-accent text-ink"
                : "border-transparent text-body hover:text-ink",
            ]}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2.5">
      <ThemeToggle />
      <a
        class="rounded-sm bg-ink px-[18px] py-[11px] text-[13.5px] font-semibold text-paper transition-colors duration-[180ms] ease-out hover:bg-accent"
        href="/#contact"
      >
        Get in touch
      </a>
    </div>
  </div>
</header>

<script>
  // When the tab strip scrolls (narrow screens), keep the current page's tab
  // in view instead of hidden off the right edge.
  function centerActiveTab() {
    const strip = document.querySelector<HTMLElement>("[data-tabs]");
    const active = strip?.querySelector<HTMLElement>('[aria-current="page"]');
    if (!strip || !active || strip.scrollWidth <= strip.clientWidth) return;

    // offsetLeft would be relative to the sticky header, so measure with rects.
    const stripBox = strip.getBoundingClientRect();
    const tabBox = active.getBoundingClientRect();
    strip.scrollLeft +=
      tabBox.left - stripBox.left - (strip.clientWidth - tabBox.width) / 2;
  }

  centerActiveTab();
  document.addEventListener("astro:page-load", centerActiveTab);
</script>
