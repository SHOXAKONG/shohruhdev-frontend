---
import { icons, type IconName } from "../icons";

interface Props {
  name: IconName;
  size?: number;
  /** Stroke weight — bump it slightly for small sizes. */
  weight?: number;
  class?: string;
}

const { name, size = 22, weight = 1.75, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
