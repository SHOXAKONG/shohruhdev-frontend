---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../data/site";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tag, tone, pubDate, readingTime, featuredLine } = post.data;
---

<article class="featured reveal">
  <div class:list={["fimg", `tone-${tone}`]}>
    <span class="badge">FEATURED</span>
    <span class="big serif">{featuredLine ?? description}</span>
  </div>
  <div class="fbody">
    <div class="meta">
      <span class:list={["tagchip", `tone-${tone}`]}>{tag}</span> · {
        formatDate(pubDate)
      } · {readingTime} min read
    </div>
    <h2 class="serif">{title}</h2>
    <p>{description}</p>
    <a class="btn btn-primary" href={`/blog/${post.id}`}>Read article</a>
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin: 40px 0;
  }

  .fimg {
    background: var(--slab);
    color: var(--slab-fg);
    min-height: 320px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .badge {
    align-self: flex-start;
    border: 1px solid var(--slab-line);
    color: var(--slab-fg);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    padding: 5px 10px;
    border-radius: var(--r-sm);
  }

  .big {
    font-weight: 700;
    font-size: 32px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--slab-fg);
    max-width: 18ch;
  }

  .fbody {
    padding: 40px;
  }

  .fbody .meta {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .fbody h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.12;
    margin-bottom: 14px;
  }

  .fbody p {
    color: var(--body);
    font-size: 15.5px;
    margin-bottom: 24px;
  }

  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
