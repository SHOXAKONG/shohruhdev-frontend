---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../data/site";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tag, pubDate, readingTime, featuredLine } = post.data;
---

<article class="reveal my-10 grid grid-cols-[1.15fr_0.85fr] overflow-hidden rounded-lg border border-line bg-surface max-[820px]:grid-cols-1">
  <div class="flex min-h-[320px] flex-col justify-between bg-slab p-8 text-slab-fg">
    <span class="self-start rounded-sm border border-slab-line px-2.5 py-[5px] font-mono text-[10.5px] tracking-[0.14em] text-slab-fg">
      FEATURED
    </span>
    <span class="max-w-[18ch] font-serif text-[32px] leading-[1.12] font-bold tracking-[-0.025em] text-slab-fg">
      {featuredLine ?? description}
    </span>
  </div>
  <div class="p-10">
    <div class="mb-4 flex items-center gap-2.5 text-[13px] text-muted">
      <span class="rounded-sm border border-line px-2 py-1 font-mono text-[10.5px] font-medium tracking-[0.1em] text-muted uppercase">
        {tag}
      </span>{" "}
      · {formatDate(pubDate)} · {readingTime} min read
    </div>
    <h2 class="mb-3.5 font-serif text-[30px] leading-[1.12] font-semibold">{title}</h2>
    <p class="mb-6 text-[15.5px] text-body">{description}</p>
    <a
      class="inline-flex items-center gap-2 rounded-sm bg-accent px-[22px] py-[13px] text-[14.5px] font-semibold tracking-[-0.01em] text-paper transition-colors duration-[180ms] ease-out hover:bg-accent-strong"
      href={`/blog/${post.id}`}
    >
      Read article
    </a>
  </div>
</article>
