---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../data/site";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tag, pubDate, readingTime, category } = post.data;
---

<a
  class="group reveal flex flex-col border-t-2 border-ink pt-[18px] pb-6 transition-colors duration-[180ms] ease-out hover:border-accent"
  href={`/blog/${post.id}`}
  data-category={category}
>
  <div class="mb-4 flex items-baseline justify-between gap-3 font-mono text-[10.5px] tracking-[0.12em] uppercase">
    <span class="text-accent">{tag}</span>
    <span class="text-muted">{formatDate(pubDate)}</span>
  </div>
  <h3 class="mb-2.5 text-xl leading-[1.2] font-bold tracking-[-0.02em] transition-colors duration-[180ms] ease-out group-hover:text-accent">
    {title}
  </h3>
  <p class="mb-[18px] text-[14.5px] leading-[1.55] text-body">{description}</p>
  <span class="mt-auto font-mono text-[10.5px] tracking-[0.12em] text-muted uppercase">
    {readingTime} min read
  </span>
</a>
