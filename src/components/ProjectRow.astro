---
import type { Project } from "../data/site";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");

const blocks = [
  { label: "The problem", text: project.problem },
  { label: "What I changed", text: project.approach },
  { label: "What it bought", text: project.result },
];
---

<article
  id={project.slug}
  class:list={[
    `tone-${project.tone}`,
    "reveal group relative grid scroll-mt-[110px] grid-cols-[88px_minmax(0,1fr)_190px] items-start gap-7 rounded-md border-b border-line px-8 py-[38px] transition-colors duration-[250ms] ease-out hover:border-b-transparent hover:bg-surface max-[860px]:grid-cols-[54px_minmax(0,1fr)] max-[860px]:gap-[18px] max-[860px]:px-[18px] max-[860px]:py-[30px]",
  ]}
>
  <span
    class="absolute top-6 bottom-6 left-0 w-1 origin-center scale-y-0 rounded-sm bg-accent opacity-0 transition-[transform,opacity] duration-300 ease-out group-hover:scale-y-100 group-hover:opacity-100"
    aria-hidden="true"
  />
  <span
    class="font-serif text-[46px] leading-none font-semibold text-muted opacity-50 [font-variant-numeric:tabular-nums] transition-colors duration-[250ms] ease-out group-hover:text-[color:var(--tone-fg)] group-hover:opacity-100 max-[860px]:text-[30px]"
    aria-hidden="true"
  >
    {number}
  </span>

  <div>
    <span class="font-mono text-[11px] font-medium tracking-[0.16em] text-muted uppercase">
      {project.category}
    </span>
    <h2 class="mt-2.5 mb-5 font-serif text-[27px] leading-[1.15] font-semibold tracking-[-0.01em]">
      {project.title}
    </h2>

    <div class="flex max-w-[64ch] flex-col gap-[18px]">
      {
        blocks.map((block) => (
          <div>
            <span class="mb-1.5 block font-mono text-[10px] tracking-[0.18em] text-[color:var(--tone-fg)] uppercase">
              {block.label}
            </span>
            <p class="text-[15.5px] leading-[1.62] text-body">{block.text}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="flex flex-col items-end gap-4 pt-0.5 text-right max-[860px]:col-start-2 max-[860px]:mt-5 max-[860px]:w-full max-[860px]:flex-row max-[860px]:items-center max-[860px]:justify-between max-[860px]:text-left">
    <span class="rounded-sm bg-[color:var(--tone-bg)] px-3.5 py-2.5 font-serif text-[17px] leading-[1.25] font-normal text-[color:var(--tone-fg)] italic">
      {project.outcome}
    </span>
    {
      project.href && (
        <a
          class="grid size-[42px] place-items-center rounded-full border-[1.5px] border-line text-[17px] text-[color:var(--tone-fg)] transition-all duration-200 hover:-translate-y-[3px] hover:translate-x-[3px] hover:border-transparent hover:bg-[color:var(--tone-bg)]"
          href={project.href}
        >
          <span aria-hidden="true">→</span>
          <span class="sr-only">View {project.title}</span>
        </a>
      )
    }
  </div>
</article>
