---
import Icon from "./Icon.astro";
import type { Skill } from "../data/site";

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
---

<div class="reveal rounded-md border border-line bg-surface p-[30px] px-7">
  <div class="mb-[18px] grid size-[46px] place-items-center rounded-[13px] bg-accent-tint text-accent">
    <Icon name={skill.icon} size={22} />
  </div>
  <h3 class="mb-2 font-serif text-xl font-semibold">{skill.title}</h3>
  <p class="mb-[18px] text-sm text-body">{skill.sub}</p>
  <ul class="flex flex-col gap-[9px]">
    {
      skill.items.map((item) => (
        <li class="flex items-center gap-2.5 text-sm text-body before:size-1.5 before:flex-none before:rounded-full before:bg-accent">
          {item}
        </li>
      ))
    }
  </ul>
</div>
