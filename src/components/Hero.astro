---
import { getCollection } from "astro:content";
import { focus, site, stats } from "../data/site";

// Newest post, so the last row is live rather than a standing claim.
const [latest] = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const meta = [
  { label: "Currently", value: site.company },
  { label: "Shipping", value: `${stats[0].value} years` },
  ...(latest
    ? [{ label: "Latest", value: latest.data.title, href: `/blog/${latest.id}` }]
    : []),
];
---

<section class="wrap pt-24 pb-28 max-[900px]:pt-14 max-[900px]:pb-20">
  <h1 class="mb-[52px] max-w-[15ch] font-serif text-[clamp(44px,8.2vw,104px)] leading-[0.94] font-semibold tracking-[-0.035em] max-[900px]:mb-[38px] max-[900px]:max-w-none">
    I keep the numbers{" "}
    <em class="font-light whitespace-nowrap text-accent italic">honest.</em>
  </h1>

  <div class="grid grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] gap-16 border-t border-line pt-[30px] max-[900px]:grid-cols-[minmax(0,1fr)] max-[900px]:gap-[38px]">
    <div>
      <figure class="relative mb-11 max-w-[56ch] pl-2">
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-9 -left-1 font-serif text-[96px] leading-none text-accent/20 select-none"
        >
          “
        </span>
        <blockquote class="relative border-l-2 border-accent pl-6 font-serif text-[clamp(26px,3vw,36px)] leading-[1.28] font-light tracking-[-0.01em] text-ink italic">
          It is not enough for code to work.
        </blockquote>
        <figcaption class="mt-4 pl-6 font-mono text-[11.5px] tracking-[0.1em] text-muted uppercase">
          — Robert C. Martin, <cite class="not-italic">Clean Code</cite>
        </figcaption>
      </figure>
      <div class="flex flex-wrap items-center gap-[26px]">
        <a
          class="inline-flex items-center gap-2 rounded-sm bg-accent px-[22px] py-[13px] text-[14.5px] font-semibold tracking-[-0.01em] text-paper transition-colors duration-[180ms] ease-out hover:bg-accent-strong"
          href="#work"
        >
          See the work
        </a>
        <a
          class="group inline-flex items-center gap-2 border-b-[1.5px] border-line pb-0.5 text-[15px] font-semibold transition-colors duration-200 hover:border-accent hover:text-accent"
          href="/blog"
        >
          Read the blog{" "}
          <span class="text-accent transition-transform duration-200 group-hover:translate-x-[3px]">
            →
          </span>
        </a>
      </div>
    </div>

    <dl>
      {
        meta.map((row) => (
          <div class="flex items-baseline justify-between gap-[18px] border-b border-line py-[11px] first:pt-0">
            <dt class="font-mono text-[10.5px] tracking-[0.16em] whitespace-nowrap text-muted uppercase">
              {row.label}
            </dt>
            <dd class="min-w-0 text-right text-[15px] font-medium">
              {row.href ? (
                <a
                  class="line-clamp-2 border-b border-line transition-colors duration-200 hover:border-accent hover:text-accent"
                  href={row.href}
                >
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <ol
    class="mt-16 grid grid-cols-2 gap-x-16 border-t border-line max-[900px]:mt-[46px] max-[900px]:grid-cols-1"
    aria-label="What usually lands on my desk"
  >
    {
      focus.map((item, i) => (
        <li class="border-b border-line">
          <a
            class="group flex cursor-pointer items-baseline gap-4 px-0.5 py-[17px] transition-[padding] duration-200 ease-out hover:pl-2"
            href={item.href}
          >
            <span class="font-mono text-[11px] text-muted transition-colors duration-200 group-hover:text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="font-serif text-[19px] font-medium transition-colors duration-200 group-hover:text-accent">
              {item.label}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
