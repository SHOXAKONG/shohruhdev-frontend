---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const mailto = `mailto:${site.email}`;
---

<section id="contact" class="wrap cta-band">
  <div class="cta-box reveal">
    <div class="cta-l">
      <span class="avail"><span class="adot"></span>Available for new projects</span>
      <h2 class="serif">Something your team keeps working around?</h2>
      <p class="ctext">
        That's usually where the real problem is hiding. Tell me what it costs you every
        week and I'll tell you what I'd change.
      </p>
      <div class="cta-actions">
        <a class="btn btn-white" href={mailto}>Send an email</a>
        <a class="btn btn-outline-w" href={site.github}>View GitHub</a>
      </div>
    </div>
    <div class="cta-card">
      <a class="crow" href={mailto}>
        <span class="cico"><Icon name="mail" size={20} /></span>
        <span>
          <span class="clabel">Email</span>
          <span class="cval">{site.email}</span>
        </span>
      </a>
      <a class="crow" href={site.github}>
        <span class="cico"><Icon name="branch" size={20} /></span>
        <span>
          <span class="clabel">GitHub</span>
          <span class="cval">{site.githubLabel}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: 24px 88px;
  }

  .cta-box {
    background: var(--slab);
    border-radius: var(--r-lg);
    padding: 54px 52px;
    color: var(--slab-fg);
    display: grid;
    /* minmax(0, …): the email address is one long unbreakable word, and an
       `auto` track minimum would let it push the card past the viewport. */
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .cta-l {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--slab-line);
    padding: 6px 12px;
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .adot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .cta-box h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.06;
    margin-bottom: 14px;
  }

  .ctext {
    opacity: 0.92;
    max-width: 400px;
    margin-bottom: 28px;
    font-size: 17px;
  }

  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta-card {
    position: relative;
    z-index: 1;
    min-width: 0;
    border: 1px solid var(--slab-line);
    border-radius: var(--r-md);
  }

  .crow {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    transition: 0.2s;
    color: var(--slab-fg);
  }

  .crow:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .crow + .crow {
    border-top: 1px solid var(--slab-line);
  }

  .cico {
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    border: 1px solid var(--slab-line);
    display: grid;
    place-items: center;
    color: var(--slab-fg);
    flex: none;
  }

  .cico + span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .clabel {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
    font-family: var(--font-mono);
  }

  .cval {
    font-size: 15px;
    font-weight: 600;
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 820px) {
    .cta-box {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
      padding: 38px 28px;
    }
  }
</style>
