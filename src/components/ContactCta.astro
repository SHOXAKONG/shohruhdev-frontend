---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const mailto = `mailto:${site.email}`;
---

<section id="contact" class="wrap pt-6 pb-[88px]">
  <div class="reveal relative grid grid-cols-[minmax(0,1.25fr)_minmax(0,0.9fr)] items-center gap-12 overflow-hidden rounded-lg bg-slab py-[54px] px-[52px] text-slab-fg max-[820px]:grid-cols-[minmax(0,1fr)] max-[820px]:gap-[30px] max-[820px]:py-[38px] max-[820px]:px-7">
    <div class="relative z-[1] min-w-0">
      <span class="mb-[18px] inline-flex items-center gap-[9px] rounded-sm border border-slab-line px-3 py-1.5 font-mono text-[11px] tracking-[0.1em] uppercase">
        <span class="size-2 rounded-full bg-accent"></span>Available for new projects
      </span>
      <h2 class="mb-3.5 font-serif text-[clamp(28px,3.4vw,42px)] leading-[1.06] font-semibold">
        Something your team keeps working around?
      </h2>
      <p class="mb-7 max-w-[400px] text-[17px] opacity-[0.92]">
        That's usually where the real problem is hiding. Tell me what it costs you every
        week and I'll tell you what I'd change.
      </p>
      <div class="flex flex-wrap gap-3.5">
        <a
          class="inline-flex items-center gap-2 rounded-sm bg-slab-fg px-[22px] py-[13px] text-[14.5px] font-semibold tracking-[-0.01em] text-on-light transition-colors duration-[180ms] ease-out hover:bg-paper-2"
          href={mailto}
        >
          Send an email
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-sm border-[1.5px] border-slab-line px-[22px] py-[13px] text-[14.5px] font-semibold tracking-[-0.01em] text-slab-fg transition-colors duration-[180ms] ease-out hover:bg-white/[0.08]"
          href={site.github}
        >
          View GitHub
        </a>
      </div>
    </div>
    <div class="relative z-[1] min-w-0 rounded-md border border-slab-line">
      <a
        class="flex items-center gap-3.5 p-[18px] text-slab-fg transition-colors duration-200 hover:bg-white/[0.07]"
        href={mailto}
      >
        <span class="grid size-[34px] flex-none place-items-center rounded-sm border border-slab-line text-slab-fg">
          <Icon name="mail" size={20} />
        </span>
        <span class="flex min-w-0 flex-col">
          <span class="font-mono text-[11px] tracking-[0.12em] uppercase opacity-[0.72]">Email</span>
          <span class="mt-0.5 overflow-hidden text-[15px] font-semibold text-ellipsis">{site.email}</span>
        </span>
      </a>
      <a
        class="flex items-center gap-3.5 border-t border-slab-line p-[18px] text-slab-fg transition-colors duration-200 hover:bg-white/[0.07]"
        href={site.github}
      >
        <span class="grid size-[34px] flex-none place-items-center rounded-sm border border-slab-line text-slab-fg">
          <Icon name="branch" size={20} />
        </span>
        <span class="flex min-w-0 flex-col">
          <span class="font-mono text-[11px] tracking-[0.12em] uppercase opacity-[0.72]">GitHub</span>
          <span class="mt-0.5 overflow-hidden text-[15px] font-semibold text-ellipsis">{site.githubLabel}</span>
        </span>
      </a>
    </div>
  </div>
</section>
